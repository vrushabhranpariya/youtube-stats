{
	"manifest_version": 3,
	"name": "YouTube Stats",
	"version": "1.0.1",
	"description": "Shows like, dislike and comment counts on YouTube video cards, watch pages, and Shorts.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"js": [
				"content.js"
			],
			"css": [
				"styles.css"
			],
			"run_at": "document_idle"
		}
	],
	"host_permissions": [
		"https://returnyoutubedislike.com/*"
	]
}